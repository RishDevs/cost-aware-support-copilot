# ============================================================
# Cost-Aware LLM Support Copilot — Environment Configuration
# ============================================================

# --- LLM Providers ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...

# --- Model Tier Mappings ---
TIER_A_MODEL=gpt-3.5-turbo          # cheap-fast
TIER_B_MODEL=gpt-4o-mini            # balanced
TIER_C_MODEL=gpt-4o                 # premium

# --- Embedding Model ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Database ---
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot_db
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis Cache ---
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.92

# --- Vector DB (pgvector) ---
VECTOR_COLLECTION=support_chunks
VECTOR_DIM=1536
TOP_K_DEFAULT=6
RERANKER_TOP_K=3

# --- Cost Controls ---
DAILY_BUDGET_USD=50.00
BUDGET_ALERT_PCT=0.80
EMERGENCY_CHEAP_MODE_PCT=0.95

# --- Router Config ---
CONFIDENCE_HIGH_THRESHOLD=0.75
CONFIDENCE_LOW_THRESHOLD=0.40
ESCALATION_THRESHOLD=0.35

# --- API Config ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=SupportCopilot

# --- Observability ---
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Feature Flags ---
ENABLE_CACHING=true
ENABLE_RERANKER=true
ENABLE_TOOLS=true
ENABLE_GUARDRAILS=true
ENABLE_PII_REDACTION=true
DEBUG_MODE=false
